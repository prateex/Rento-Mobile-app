# Backend Supabase credentials (copy to .env for cloud, or .env.local for local dev)
#
# LOCAL: run `supabase status -o env` and copy API_URL, ANON_KEY, SERVICE_ROLE_KEY
# CLOUD: use values from Supabase Dashboard → Project Settings → API
#
# IMPORTANT: Must match the same project the frontend uses (VITE_* in client/.env.local).
# A local frontend JWT will fail with 401 if the backend points at cloud Supabase.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
